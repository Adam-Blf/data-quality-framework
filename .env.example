# No secrets are required to run this project: the source dataset is public
# open data (Licence Ouverte v2.0) and is fetched anonymously over HTTPS.
# This file only documents the tunable knobs, kept as env vars for consistency
# with the rest of Adam's projects.

# Maximum age, in days, before the freshness check fails the quality gate.
MAX_STALENESS_DAYS=180
