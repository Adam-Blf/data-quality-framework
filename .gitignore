# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Great Expectations runtime artefacts (regenerated by scripts/build_and_run_suite.py)
gx/uncommitted/

# Data (downloaded fresh via scripts/fetch_data.py, not versioned)
data/raw/*.csv
data/raw/*.csv.bak
data/raw/metadata.json
reports/*.html

# Secrets, never commit
*secret*
*.token
.env
.env.*
!.env.example
*.pem
ghp_*
sbp_*
github_pat_*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
